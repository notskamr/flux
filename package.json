    "drizzle-orm": "^0.30.10",
    "hono": "^4.12.23"
  },
  "engines": {
    "bun": ">=1.2.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.11",
    "drizzle-kit": "^0.20.18"
  }
}